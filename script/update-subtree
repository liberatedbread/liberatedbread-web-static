#!/usr/bin/env bash
# shellcheck shell=bash
#
# Pulls the latest device specs from liberatedbread-protocol-specs into this
# repo's `device-specs/` prefix.
#
#   script/update-subtree [--dry-run] [--verify] [options]
#
#
# WHY THIS SCRIPT EXISTS RATHER THAN A LINE IN THE README
# -------------------------------------------------------
# The obvious command — `git subtree pull --prefix=device-specs <remote> main
# --squash` — is WRONG here, and wrong in the worst way: it succeeds, and it
# replaces the specs with the wrong content.
#
# `git subtree pull` merges the ROOT of the remote branch into the prefix. But
# upstream's root is a whole Python project — docs/, scripts/, tools/,
# mkdocs.yml, pyproject.toml — and the specs are one subdirectory of it,
# `device-specs/`. Pulling the branch root would dump that entire project into
# this site's device-specs/ and serve it at liberatedbread.com.
#
# What was actually vendored (commit c92e13c, "Squashed 'device-specs/' content
# from commit 7b58352") is a `git subtree split` of upstream's `device-specs/`
# SUBDIRECTORY. Upstream keeps a `device-specs-split` branch holding that split,
# and 7b58352 is its tip — but that branch is regenerated by hand and was
# already three commits behind `main` when this was written, so pointing the
# script at it would quietly ship stale specs.
#
# So this script does the split itself, against upstream `main`:
#
#     git fetch  <url> main
#     git subtree split --prefix=device-specs  <fetched sha>   -> $split
#     git subtree merge --prefix=device-specs --squash $split
#
# The split is deterministic. Re-running step two against the commit this repo
# vendored (upstream b0d812a) reproduces 7b58352 bit for bit — the exact sha
# recorded in c92e13c's `git-subtree-split:` trailer. That is the proof that
# this is the same operation the subtree was created with, and it is why the
# defaults below are `main` + a split, not the `device-specs-split` branch.
#
# --squash matches how the subtree was added. Without it, every upstream commit
# is grafted into this repo's history.
#
#
# THE POST-MERGE ASSERTION IS THE POINT
# --------------------------------------
# After merging, the script asserts that `HEAD:device-specs` is byte-identical
# to upstream's `device-specs/` tree. Getting the prefix wrong, resolving the
# wrong branch, or a half-resolved conflict all produce a plausible-looking
# tree; this turns any of them into a loud failure instead of a bad commit.
#
#
# AND WHY IT NAGS ABOUT THE LINK CHECK
# -------------------------------------
# Upstream Markdown is written for upstream's layout, and its relative links
# point at files that do not exist in this repo. That broke CI once already.
# `_config.yml` now disables jekyll-readme-index and jekyll-optional-front-
# matter so no vendored Markdown is ever rendered into a page, which should
# make that permanent — but an upstream change is exactly the event that would
# test it. Run the checks. `--verify` runs them for you.
#
# See README.md, "Updating the vendored device specs".

set -euo pipefail

# Defaults. Every one is overridable by flag or environment variable; the flag
# wins. The URL is the public clone URL — override it with UPDATE_SUBTREE_URL
# to test against a local clone.
REMOTE="${UPDATE_SUBTREE_REMOTE:-protocol-specs}"
URL="${UPDATE_SUBTREE_URL:-git@github.com:liberatedbread/liberatedbread-protocol-specs.git}"
BRANCH="${UPDATE_SUBTREE_BRANCH:-main}"
PREFIX="${UPDATE_SUBTREE_PREFIX:-device-specs}"
UPSTREAM_DIR="${UPDATE_SUBTREE_UPSTREAM_DIR:-device-specs}"

DRY_RUN=0
VERIFY=0

usage() {
  cat <<EOF
Update the vendored device specs from liberatedbread-protocol-specs.

Usage:
  script/update-subtree [options]

Options:
  -n, --dry-run          Show what would change and exit. Fetches upstream
                         (which only adds objects to .git) but creates no
                         commit, touches no tracked file, and does not add or
                         modify the git remote.
      --verify           After a successful update, run the Jekyll build and
                         the internal link check. Without this the commands are
                         printed for you to run.
      --remote NAME      Git remote name for upstream.
                         (default: ${REMOTE})
      --url URL          Upstream clone URL. The remote is created, or pointed
                         at this, as needed.
                         (default: ${URL})
      --branch NAME      Upstream branch to take the specs from.
                         (default: ${BRANCH})
      --prefix PATH      Path in THIS repo the specs live at.
                         (default: ${PREFIX})
      --upstream-dir PATH
                         Directory WITHIN the upstream branch that is split out
                         and merged into --prefix.
                         (default: ${UPSTREAM_DIR})
  -h, --help             Show this help and exit.

Environment variables (flags take precedence):
  UPDATE_SUBTREE_REMOTE  UPDATE_SUBTREE_URL     UPDATE_SUBTREE_BRANCH
  UPDATE_SUBTREE_PREFIX  UPDATE_SUBTREE_UPSTREAM_DIR

Examples:
  script/update-subtree --dry-run          # what would change?
  script/update-subtree --verify           # update, then build and link-check
  UPDATE_SUBTREE_URL=/path/to/clone script/update-subtree --dry-run
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

note() { echo "  $*"; }

# A flag that takes a value must actually have been given one, or the next flag
# is silently swallowed as its argument.
need_value() {
  [ "$2" -gt 1 ] || die "$1 requires a value"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -n | --dry-run) DRY_RUN=1 ;;
    --verify) VERIFY=1 ;;
    --remote)
      need_value "$1" $#
      REMOTE="$2"
      shift
      ;;
    --url)
      need_value "$1" $#
      URL="$2"
      shift
      ;;
    --branch)
      need_value "$1" $#
      BRANCH="$2"
      shift
      ;;
    --prefix)
      need_value "$1" $#
      PREFIX="$2"
      shift
      ;;
    --upstream-dir)
      need_value "$1" $#
      UPSTREAM_DIR="$2"
      shift
      ;;
    *)
      usage >&2
      die "unknown argument: $1"
      ;;
  esac
  shift
done

# Trailing slashes would turn `HEAD:device-specs/` into an invalid rev spec and
# make the tree comparison below fail for a reason that reads like corruption.
PREFIX="${PREFIX%/}"
UPSTREAM_DIR="${UPSTREAM_DIR%/}"
[ -n "$PREFIX" ] || die "--prefix must not be empty"
[ -n "$UPSTREAM_DIR" ] || die "--upstream-dir must not be empty"

# ---------------------------------------------------------------------------
# Preconditions
# ---------------------------------------------------------------------------

git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || die "not inside a git repository"

# Run from the repo root regardless of where the caller invoked us, so --prefix
# means the same thing every time and `bundle exec` below finds the Gemfile.
cd "$(git rev-parse --show-toplevel)"

[ -d "$PREFIX" ] || die "$PREFIX/ does not exist — this script updates an existing subtree, it does not add one.
       To add it the first time:
         git subtree add --prefix=$PREFIX --squash <split-ref>"

git cat-file -e "HEAD:$PREFIX" 2>/dev/null \
  || die "$PREFIX/ is not tracked at HEAD — it is not a subtree"

# Tracked changes only, staged or not. That is git-subtree's own definition of
# a dirty tree (`require_clean_work_tree`), and it is the right one: the merge
# rewrites tracked files under the prefix, while untracked files — a stray
# _site/, a scratch note — are in no danger from it. A dry run mutates nothing,
# so it is allowed to proceed either way.
if ! git diff --quiet || ! git diff --cached --quiet; then
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "note: working tree has uncommitted changes; a real run would refuse." >&2
  else
    git --no-pager status --short --untracked-files=no >&2
    die "working tree has uncommitted changes — commit or stash them first.
       The subtree merge writes a commit, and an interrupted merge on top of
       unrelated edits is painful to unpick."
  fi
fi

# ---------------------------------------------------------------------------
# Fetch
# ---------------------------------------------------------------------------

echo "Updating $PREFIX/ from $URL ($BRANCH:$UPSTREAM_DIR/)"
echo

if [ "$DRY_RUN" -eq 1 ]; then
  # Fetch straight from the URL. This leaves .git/config untouched, so a dry
  # run cannot surprise anyone by rewriting an existing remote.
  if git remote get-url "$REMOTE" >/dev/null 2>&1; then
    existing="$(git remote get-url "$REMOTE")"
    if [ "$existing" = "$URL" ]; then
      note "remote '$REMOTE' already points at $URL"
    else
      note "would repoint remote '$REMOTE': $existing -> $URL"
    fi
  else
    note "would add remote '$REMOTE' -> $URL"
  fi
  git fetch --no-tags "$URL" "$BRANCH" >/dev/null 2>&1 \
    || die "could not fetch $BRANCH from $URL"
else
  if git remote get-url "$REMOTE" >/dev/null 2>&1; then
    existing="$(git remote get-url "$REMOTE")"
    if [ "$existing" = "$URL" ]; then
      note "remote '$REMOTE' already points at $URL"
    else
      note "repointing remote '$REMOTE': $existing -> $URL"
      git remote set-url "$REMOTE" "$URL"
    fi
  else
    note "adding remote '$REMOTE' -> $URL"
    git remote add "$REMOTE" "$URL"
  fi
  git fetch --no-tags "$REMOTE" "$BRANCH" \
    || die "could not fetch $BRANCH from $REMOTE ($URL)"
fi

# FETCH_HEAD rather than $REMOTE/$BRANCH: it is set identically by both fetches
# above and does not depend on the remote having a default fetch refspec.
UPSTREAM_SHA="$(git rev-parse FETCH_HEAD)"

git cat-file -e "$UPSTREAM_SHA:$UPSTREAM_DIR" 2>/dev/null \
  || die "$BRANCH has no '$UPSTREAM_DIR/' directory at $UPSTREAM_SHA.
       If upstream moved the specs, pass --upstream-dir."

CURRENT_TREE="$(git rev-parse "HEAD:$PREFIX")"
UPSTREAM_TREE="$(git rev-parse "$UPSTREAM_SHA:$UPSTREAM_DIR")"

note "upstream $BRANCH is $(git rev-parse --short "$UPSTREAM_SHA") ($(git log -1 --format=%s "$UPSTREAM_SHA"))"

# The `git-subtree-split:` trailer on the last squash commit. Informational —
# nothing below depends on it — but it is the only record of where the current
# content came from, so it is worth surfacing.
LAST_SPLIT="$(git log -1 --format='%B' --grep="^git-subtree-dir: ${PREFIX}/*\$" \
  | sed -n 's/^git-subtree-split: //p' | head -1)"
if [ -n "$LAST_SPLIT" ]; then
  note "last vendored split was ${LAST_SPLIT:0:7}"
fi

echo

# ---------------------------------------------------------------------------
# Already up to date?
# ---------------------------------------------------------------------------
#
# Compared by tree, not by commit sha. Upstream can move on without touching
# the specs, and rebuilding a split just to discover nothing changed is slow
# and leaves dangling commits behind.
if [ "$CURRENT_TREE" = "$UPSTREAM_TREE" ]; then
  echo "Already up to date — $PREFIX/ is identical to $BRANCH:$UPSTREAM_DIR/."
  exit 0
fi

echo "Changes upstream:"
git --no-pager diff --stat "$CURRENT_TREE" "$UPSTREAM_TREE"
echo

if [ "$DRY_RUN" -eq 1 ]; then
  cat <<EOF
Dry run — nothing was committed and no tracked file was touched.

A real run would:
  git subtree split --prefix=$UPSTREAM_DIR $(git rev-parse --short "$UPSTREAM_SHA")
  git subtree merge --prefix=$PREFIX --squash <that split commit>

Re-run without --dry-run to apply.
EOF
  exit 0
fi

# ---------------------------------------------------------------------------
# Split and merge
# ---------------------------------------------------------------------------

echo "Splitting $UPSTREAM_DIR/ out of upstream history (this can take a minute)..."

# git-subtree prints progress on stderr and the resulting commit sha on stdout.
SPLIT="$(git subtree split --prefix="$UPSTREAM_DIR" "$UPSTREAM_SHA" | tail -1)"
[ -n "$SPLIT" ] || die "git subtree split produced no commit"

git rev-parse --verify --quiet "$SPLIT^{commit}" >/dev/null \
  || die "git subtree split returned something that is not a commit: $SPLIT"

# Cheap guard before we commit anything: the split must reproduce upstream's
# directory exactly. If it does not, --upstream-dir is wrong.
SPLIT_TREE="$(git rev-parse "$SPLIT^{tree}")"
[ "$SPLIT_TREE" = "$UPSTREAM_TREE" ] \
  || die "split tree $SPLIT_TREE != upstream $UPSTREAM_DIR/ tree $UPSTREAM_TREE — refusing to merge"

note "split commit is $(git rev-parse --short "$SPLIT")"
echo

echo "Merging into $PREFIX/ ..."
if ! git subtree merge --prefix="$PREFIX" --squash "$SPLIT"; then
  die "git subtree merge failed.
       If it stopped on conflicts, resolve them and \`git commit\`, or abandon
       the update with \`git merge --abort\`. Conflicts here mean $PREFIX/ was
       edited locally — it must not be; upstream is the only author."
fi

# The assertion this whole script is built around. See the header.
RESULT_TREE="$(git rev-parse "HEAD:$PREFIX")"
[ "$RESULT_TREE" = "$UPSTREAM_TREE" ] || die "post-merge check FAILED.
       $PREFIX/ is $RESULT_TREE but upstream $UPSTREAM_DIR/ is $UPSTREAM_TREE.
       The commit that was just created is wrong. Undo it with:
         git reset --hard HEAD^"

echo
echo "OK — $PREFIX/ now matches $BRANCH:$UPSTREAM_DIR/ at $(git rev-parse --short "$UPSTREAM_SHA")"
git --no-pager log -1 --format='  %h %s'
echo

# ---------------------------------------------------------------------------
# Verify
# ---------------------------------------------------------------------------

if [ "$VERIFY" -eq 0 ]; then
  cat <<'EOF'
Now verify the site still builds and links cleanly — an upstream change is
exactly what would reintroduce the broken-link failure _config.yml guards
against:

  bundle exec jekyll build --strict_front_matter
  ruby script/check-links.rb _site

(or re-run this script with --verify to do both automatically)
EOF
  exit 0
fi

echo "Verifying..."
echo
echo "\$ bundle exec jekyll build --strict_front_matter"
bundle exec jekyll build --strict_front_matter \
  || die "jekyll build failed after the update. Inspect the changes, then
       \`git reset --hard HEAD^\` to back the update out."

echo
echo "\$ ruby script/check-links.rb _site"
ruby script/check-links.rb _site || die "the link check failed after the update.
       Upstream almost certainly added Markdown whose relative links do not
       resolve here. Check that _config.yml still disables jekyll-readme-index
       and jekyll-optional-front-matter, then \`git reset --hard HEAD^\` to back
       the update out."

echo
echo "OK — subtree updated and the site still builds with no broken links."
